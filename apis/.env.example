# ====== PostgreSQL ======
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db?sslmode=require

# ====== Flask ======
FLASK_SECRET_KEY=genera-una-clave-segura-con-python-secrets
FLASK_DEBUG=true
PORT=5000

# ====== Google OAuth ======
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com

# ====== OpenRouteService ======
ORS_API_KEY=tu-api-key-de-openrouteservice

# ====== Dropbox ======
DROPBOX_REFRESH_TOKEN=tu-refresh-token
DROPBOX_APP_KEY=tu-app-key
DROPBOX_APP_SECRET=tu-app-secret

# ====== Email SMTP (Gmail) ======
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=tu-app-password-de-gmail

# ====== Frontend URL (para CORS) ======
FRONTEND_URL=http://localhost:3000
